# Deterministic local review mode requires no infrastructure.
COMMERCE_MESSAGING_MODE=deterministic-local
COMMERCE_STORE_MODE=memory
COMMERCE_ALLOWED_ORIGIN=http://localhost:5180

# Full lab mode (set only through your local environment or deployment secret manager).
# COMMERCE_MESSAGING_MODE=kafka
# COMMERCE_STORE_MODE=postgres
# COMMERCE_KAFKA_BOOTSTRAP=localhost:9092
# COMMERCE_REDIS_HOST=localhost
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/commerce
# SPRING_DATASOURCE_USERNAME=commerce
# SPRING_DATASOURCE_PASSWORD=replace-with-a-local-only-secret
